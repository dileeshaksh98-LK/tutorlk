# ============================================================
# TutorLK — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Supabase — get from supabase.com > project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database — get from supabase.com > project settings > database
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# NextAuth — generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-32-char-random-secret

# Google OAuth (optional) — console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend (email) — resend.com
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@tutorlk.lk

# PayHere (payments) — payhere.lk
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_SECRET=your-payhere-secret
NEXT_PUBLIC_PAYHERE_SANDBOX=true
